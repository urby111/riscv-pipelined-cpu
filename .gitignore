# Publish source and reproducible tests; keep local workspace artifacts private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/project_1.srcs/
!/tests/
!/nano/

/project_1.srcs/*
!/project_1.srcs/sources_1/
!/project_1.srcs/sim_1/

/tests/*
!/tests/README.md
!/tests/cpu_regression.sv
!/tests/run_verilator.sh
!/tests/performance_100mhz/
!/tests/functional_fixes/
!/tests/vivado_gui/

/tests/performance_100mhz/*
!/tests/performance_100mhz/README.md
!/tests/performance_100mhz/run_reference.sh
!/tests/performance_100mhz/reference_regression.sv
!/tests/performance_100mhz/verify_validity.sv

/tests/functional_fixes/*
!/tests/functional_fixes/README.md
!/tests/functional_fixes/check_synthesis.ps1
!/tests/functional_fixes/check_synthesis.tcl

/tests/vivado_gui/*
!/tests/vivado_gui/README.md
!/tests/vivado_gui/RESULTS.md
!/tests/vivado_gui/create_project.tcl
!/tests/vivado_gui/verify_project.tcl
!/tests/vivado_gui/verify_project.ps1
!/tests/vivado_gui/cpu_gui_top.v
!/tests/vivado_gui/tb_cpu_100mhz.sv
!/tests/vivado_gui/clock_100mhz.xdc
!/tests/vivado_gui/physical.xdc
!/tests/vivado_gui/generate_program.py
!/tests/vivado_gui/gui_program.mem
!/tests/vivado_gui/expected_stores.vh
!/tests/vivado_gui/program_listing.txt
!/tests/vivado_gui/timing_100mhz.rpt
!/tests/vivado_gui/critical_paths.rpt
!/tests/vivado_gui/drc.rpt

/nano/build/
/nano/original_sources.json

# Generated outputs anywhere in published source directories.
**/.Xil/
**/__pycache__/
**/obj_dir/
*.log
*.jou
*.dcp
*.vcd
*.fst
*.wdb
*.wlf
*.bit
*.fs
*.o
*.vvp
*.pyc
